{
  "compilerOptions": {
    "declaration": true,
    "erasableSyntaxOnly": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
