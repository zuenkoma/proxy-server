{
  "compilerOptions": {
    "declaration": true,
    "erasableSyntaxOnly": true,
    "lib": ["ESNext", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "target": "esnext",
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
